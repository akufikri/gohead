  "cards": [
    {
      "dot": "cyan",
      "title": "Three gates",
      "items": [
        "Gate 1 classifies before any edit: already done, partial, or new",
        "Gate 2 names the change set before editing; anything else stays untouched",
        "Gate 3 verifies the result before the word complete is used"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the tests caught",
      "items": [
        "already-done case: 0 files changed, the answer says it is already implemented",
        "scope case: the decoy file with a pre-existing bug stayed untouched",
        "stack case: scope held with caveman and ponytail loaded, 635-character answer"
      ]
    },
    {
      "dot": "rose",
      "title": "Never",
      "items": [
        "Never treat a discovered bug as permission to fix it",
        "Never invent requirements the task did not state",
        "Never work around a blocker with an out-of-scope change"
      ]
    }
  ]
